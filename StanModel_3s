//declare likelihood and priors
model{
  
  // NBORN
nborn_raw ~ std_normal();  

  // BIRTHDAY
muBday_raw ~ std_normal();      // use normal here for now- stan also has a built in skew normal
sdBday_raw ~ gamma(0.1,0.1);    // seems to work okay- plenty of room to explore?
alphaBday_raw ~ std_normal(); // only allowing for positive skew
//alphaBday_raw ~ std_normal(); // skewness of birth distribution - moderately vague prior
// print("muBday_raw = ", muBday_raw) ;
// print("muBday = ", muBday) ;
// print("sdBday = ", sdBday) ;
// print("nborn = ", nborn) ;

 // LEAVING SUCCESSFULLY
muLeave_raw ~ std_normal();   // was uniform 20,40
sdLeave_raw ~ gamma(1,1);    // was normal 1,10

// print("muLeave = ", muLeave) ;
// print("sdLeave = ", sdLeave) ;

  // DETECTION
pobs_d ~  beta(45,5);     // strong priors
pobs_w ~ beta(45,5);
pobs_m ~ beta(45,5);
pcm ~ beta(35,5);
pcw ~ beta(35,5);

    // birth process
vector[nIntervals_c] Pb;
//Pb = normBDFunction(muBday, sdBday, nIntervals_c, daysPerBin, cohort_days);     // (normal_cdf(upper_bin_limits[z]|muBday,sdBday) - normal_cdf(lower_bin_limits[z]|muBday,sdBday))*100 ;
Pb = skewnormBDFunction(muBday, sdBday,alphaBday, nIntervals_c, daysPerBin, cohort_days);  
// print("Pb = ",Pb);

// Pb ~ dirichlet(dir_alpha);   // 
// print("Pb = ",Pb);

//leave process
vector [nIntervals_s] xzeta;
xzeta = hazFunction(muLeave,sdLeave,nIntervals_s,daysPerBin);
// print("xzeta = ",xzeta);

// local variables defined within model
vector [nIntervals_c] cohortSizeBin; 
//vector [maxDayBirth] cohortSizeDaily;

cohortSizeBin = nborn*Pb;  // distribute nborn across cohorts
// print("cohort size is ",cohortSizeBin);

//  for (c in 1:maxDayBirth){
//    cohortSizeDaily[c] = cohortSizeBin[cohndx[c]]/daysPerBin; 
//  } 
// print("cohort size day 10 = ",cohortSizeDaily[10]);
// print("cohort size day 20 = ",cohortSizeDaily[20]);
// print("cohort size day 30 = ",cohortSizeDaily[30]);
 
 
// transition matrix (one matrix defined per day of cohort age)
array[nIntervals_s] matrix[nstates,nstates] matarray;
for (i in 1:nIntervals_s){
  matarray[i] = transMatrix(xphi[((i-1)*daysPerBin)+1],xgamma[i],xzeta[i],xchi[((i-1)*daysPerBin)+1],nstates,daysPerBin);
}
// print("matarray5 =",matarray[5]);
// print("matarray10 =",matarray[10]);
// print("matarray15 =",matarray[15]);
// print("matarray20 =",matarray[20]);
//place cohorts over time 

vector[nstates] tempCohortVec;
array[nIntervals_s] vector[nstates] stageN;
for(z in 1:nIntervals_s) stageN[z] = rep_vector(0,nstates);

for(c in 1:nIntervals_c){   // loop through cohorts
  tempCohortVec = rep_vector(0,nstates);
  tempCohortVec[1] = cohortSizeBin[c];  // initialized the cohort at age 0
  stageN[c] += tempCohortVec;  // add to the cumulative matrix of pups in each class
  for(a in 1:(nIntervals_s-c)){   // loop through age of cohort
    tempCohortVec = matarray[a]*tempCohortVec;
    stageN[c+a] += tempCohortVec;  // add to the cumulative matrix of pups in each class
  }
}
// print("stageN interval 10 = ",stageN[10]);

// observation matrix

matrix[nstates,nobsstates+1]  obsMatrix=rep_matrix(0,nstates,nobsstates+1) ; 
obsMatrix[1,1]= pobs_w* pcw;         # Wreal -> Wobs 
obsMatrix[1,2] = pobs_w * (1 - pcw);  #Wreal -> Mobs
obsMatrix[1,4]= 1-pobs_w;        # Wreal -> Unobs
obsMatrix[2,1]= pobs_m*(1-pcm);  # Mreal -> Wobs
obsMatrix[2,2]= pobs_m * pcm;   # Mreal -> Mobs
obsMatrix[2,4]= 1-pobs_m;      # Mreal -> Unobs 
obsMatrix[3,4]= 1;          # Lreal -> Unobs 
obsMatrix[4,3]= pobs_d;        # Dreal -> Dobs  
obsMatrix[4,4]= 1-pobs_d;     # Dreal -> Unobs  
obsMatrix[5,4]= 1 ;         # LDreal -> Unobs 

array[nsurveys] row_vector[nobsstates+1] lambda_obs_vector;
for(obs in 1:nsurveys){
  lambda_obs_vector[obs] = stageN[obsdays_bin[obs]]' * obsMatrix ;
  
  // print("lambda_obs_vector_nsurvs =",lambda_obs_vector[obs]);
  // print("log prob before pois = ", target());
  
  obs_vector[obs,1] ~ poisson(lambda_obs_vector[obs,1] ) ; # data node- observed whites
  obs_vector[obs,2] ~ poisson(lambda_obs_vector[obs,2] ) ; # data node- observed moulteds
  obs_vector[obs,3] ~ poisson(lambda_obs_vector[obs,3] ) ; # data node- observed deads
  
  // print("log prob after pois = ", target());

}

} // end of model block 

